#cloud-config
hostname: {{ .Hostname }}
preserve_hostname: false
manage_etc_hosts: true
ssh_pwauth: true
package_update: true
package_upgrade: false

write_files:
{{- if .TeleportEnabled }}
  - path: /etc/teleport.yaml
    owner: root:root
    permissions: '0600'
    content: |
      # Managed by NKE Cloud Workflow Engine — do not edit manually.
      version: v3
      teleport:
        nodename: {{ .Hostname }}
        data_dir: /var/lib/teleport
        join_params:
          token_name: {{ .TeleportTokenName }}
          method: {{ .TeleportJoinMethod }}
        proxy_server: {{ .TeleportProxyAddress }}
        log:
          output: stderr
          severity: INFO
          format:
            output: json
        diag_addr: 127.0.0.1:3000
      ssh_service:
        enabled: "yes"
        labels:
{{ indent 10 .TeleportLabels }}
      auth_service:
        enabled: "no"
      proxy_service:
        enabled: "no"
{{- end }}
  - path: /etc/spire-agent/agent.conf
    owner: root:root
    permissions: '0644'
    content: |
      agent {
          data_dir = "/var/lib/spire-agent"
          log_level = "DEBUG"

          server_address = "{{ .SpireServerAddress }}"
          server_port = "{{ .SpireServerPort }}"

          trust_domain = "{{ .TrustDomain }}"
          trust_bundle_path = "/etc/spire-agent/initial-trust-bundle.pem"
      }

      plugins {
          KeyManager "disk" {
              plugin_data {
                  directory = "/var/lib/spire-agent"
              }
          }

          NodeAttestor "tpm" {
              plugin_cmd = "/usr/local/lib/spire-agent/tpm_attestor_agent"
              plugin_checksum = "${TPM_PLUGIN_CHECKSUM}"
              plugin_data {}
          }

          WorkloadAttestor "unix" {
              plugin_data {}
          }
      }
  - path: /etc/spire-agent/initial-trust-bundle.pem
    owner: root:root
    permissions: '0644'
    content: |
{{ indent 6 .TrustBundle }}
{{- range .Files }}
  - path: {{ quote .Path }}
    owner: {{ quote .Owner }}
    permissions: {{ quote .Permissions }}
{{- if .Encoding }}
    encoding: {{ quote .Encoding }}
{{- end }}
    content: {{ quote .Content }}
{{- end }}

runcmd:
  - systemctl stop nke-agent.service
  - systemctl stop spire-agent.service
{{- if .TeleportEnabled }}
  - echo 'Starting Teleport installation at '$(date) >> /var/log/cloud-init-teleport.log
  - DEBIAN_FRONTEND=noninteractive apt-get install -y teleport-ent=18.6.4
  - command -v teleport || { echo 'Teleport binary not found' >> /var/log/cloud-init-teleport.log; exit 1; }
  - systemctl enable --now teleport >> /var/log/cloud-init-teleport.log 2>&1
  - systemctl is-active --quiet teleport && echo 'Teleport service started successfully' >> /var/log/cloud-init-teleport.log || { echo 'Teleport service failed to start' >> /var/log/cloud-init-teleport.log; systemctl status teleport --no-pager >> /var/log/cloud-init-teleport.log; exit 1; }
  - echo 'Teleport installation completed at '$(date) >> /var/log/cloud-init-teleport.log
{{- end }}
  # On 26.04 these resolve from the nke-resolute suite, not nke-noble. The
  # reference 26.04 image already carries nke-agent and spire-agent, so this is
  # an upgrade rather than a first install there.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y nke-agent nke-kubeadm-distro-{{ trimPrefix .KubernetesVersion "v" }} spire-agent
  - [sh, -c, 'u=http://carbide-pxe.forge:18080/files/node-agent/nke-agent; if curl -fsSL "$u" -o /tmp/nke-agent; then install -m 0755 /tmp/nke-agent /usr/local/bin/nke-agent && echo "downloaded local nke-agent" && /usr/local/bin/nke-agent -version; else echo "local nke-agent not available at $u; using image agent"; fi']
{{- if .CalicoEnabled }}
  - DEBIAN_FRONTEND=noninteractive apt-get install -y nke-cni-calico-images-3.30.1 nke-cni-calico-manifests-3.30.1
{{- end }}
{{- if .OvnEnabled }}
  # The charts package is what the post-init CNI install reads.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y nke-cni-ovn-images-1.4.0 nke-cni-ovn-charts-1.4.0
{{- end }}
  # doca-networking carries its own Open vSwitch, so the distro packages come
  # off first. This runs after the CNI package installs: any apt transaction
  # after the purge can pull openvswitch back in as a dependency. The kernel
  # modules DOCA builds here only take effect on the pre-join reboot, so this
  # profile is only correct paired with a config profile that sets
  # preJoinNodeReboot: true.
  - |
      set -eu
      export DEBIAN_FRONTEND=noninteractive
      deb=doca-host_3.5.0-082000-26.07-ubuntu2604_amd64.deb
      ovs="$(dpkg-query -W -f='${Package} ${Status}\n' openvswitch-switch openvswitch-common 2>/dev/null | awk '$2 == "install" { print $1 }')"
      if [ -n "${ovs}" ]; then
        apt-get -y purge ${ovs}
      fi
      curl -fsSL "https://www.mellanox.com/downloads/DOCA/DOCA_v3.5.0/host/${deb}" -o "/tmp/${deb}"
      dpkg -i "/tmp/${deb}"
      apt-get update
      apt-get -y install doca-networking
  - sysctl --system
  - systemctl daemon-reload
  - systemctl restart spire-agent.service
  - systemctl restart nke-agent.service
  - 'systemctl restart procps || echo "Warning: procps restart failed but continuing" >> /var/log/cloud-init-teleport.log'
  - touch /run/cloud-init.done

phone_home:
    post: all
    tries: 10
    url: http://169.254.169.254:7777/latest/meta-data/phone_home
